# AI Workflow Environment Configuration
# Copy this file to .env.local and fill in your values
# 全部为可选配置；不配置也能直接运行体验

# ===========================================
# LLM（OpenAI 兼容，默认 DeepSeek）
# ===========================================
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# 界面默认 API Key（可留空，由用户在界面设置面板填写）
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===========================================
# 可选：登录保护（设置后全站需登录，一年免登录）
# 不设置则跳过登录保护
# ===========================================
# AIWF_ACCESS_USER=your_user
# AIWF_ACCESS_PASS=your_password

# ===========================================
# Optional: Alibaba Cloud OSS Configuration
# (For cloud storage of generated assets)
# ===========================================
OSS_REGION=oss-us-west-1
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_CNAME=false
OSS_ENDPOINT=https://your-oss-endpoint.com
OSS_UPLOAD_PREFIX=frontend/workflow

# ===========================================
# Optional: Supabase Configuration
# (For workflow history persistence)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_TABLE_NAME=workflow_histories
